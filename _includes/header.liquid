<style>
  :root {
    --paper: #fbfaf6;
    --ink: #1f2930;
    --muted: #5f666b;
    --chrome: #1b3a4b;
    --chrome-line: #6d94ab;
    --accent: #7a1a1a;
    --current: #b4232a;
    --rule: rgba(27, 58, 75, 0.18);
  }
  body {
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  body > [role="main"] {
    flex: 1 0 auto;
  }
  h1,
  h2,
  h3,
  .post-title,
  .navbar-brand {
    font-family: Georgia, "Times New Roman", serif;
  }
  .post-title .font-weight-bold,
  .navbar-brand .font-weight-bold {
    font-weight: 400 !important;
  }
  .author > em {
    border-bottom: none;
    font-style: normal;
    font-weight: 400;
  }
  h1.post-title {
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--chrome);
  }
  .post .desc {
    letter-spacing: 0.01em;
    color: var(--muted);
    font-family: Georgia, "Times New Roman", serif;
  }
  article p,
  .post p {
    line-height: 1.65;
  }
  article a,
  .post a {
    color: var(--accent);
  }
  #navbar {
    background: var(--chrome) !important;
    border-bottom: 4px solid var(--chrome-line);
    box-shadow: none !important;
  }
  .navbar-brand,
  .navbar-brand:hover,
  .navbar-brand:focus {
    color: #f7f4ee !important;
    font-size: 1.55rem;
    font-weight: 400 !important;
  }
  .navbar .nav-link {
    color: #f7f4ee !important;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    border-bottom: 3px solid transparent;
    padding-bottom: 0.35rem;
  }
  .navbar .nav-link:hover,
  .navbar .nav-link:focus {
    color: #ffffff !important;
    border-bottom-color: var(--chrome-line);
  }
  .navbar .nav-item.active > .nav-link {
    color: #ffffff !important;
    border-bottom-color: var(--current);
  }
  .navbar .icon-bar {
    background-color: #f7f4ee;
  }
  .navbar-collapse,
  .navbar-collapse.show {
    background: var(--chrome);
  }
  .publications h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: 0.04em;
    font-size: 1.15rem;
    color: var(--chrome);
  }
  .container.mt-5 {
    margin-top: 1rem !important;
  }
  h1.post-title {
    margin-bottom: 0.15rem;
    font-size: 1.75rem;
  }
  .post-header {
    margin-bottom: 0.7rem;
  }
  p.desc,
  .post-description {
    margin: 0;
  }
  .profile {
    width: 11rem !important;
    max-width: 11rem;
    margin: 0.15rem 0 0.35rem 1.1rem !important;
    padding: 0;
    background: #fff;
    border: 1px solid var(--rule);
    float: right;
  }
  .profile img,
  .profile .img-fluid,
  .profile figure,
  .profile picture {
    display: block;
    width: 11rem !important;
    max-width: 100%;
    height: auto !important;
    margin: 0;
  }
  .profile img,
  .profile .img-fluid {
    border-radius: 0 !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    object-position: center !important;
    background: #fff;
    box-shadow: none !important;
  }
  .post .clearfix p {
    margin-bottom: 0.4rem;
  }
  .post .clearfix p:last-child {
    margin-bottom: 0;
  }
  .social {
    clear: both;
    text-align: left !important;
    margin-top: 0.55rem;
  }
  .social .contact-icons {
    font-size: 1.05rem !important;
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .social .contact-icons a svg,
  .social .contact-icons a img,
  .social .contact-icons a i {
    width: 1.05rem !important;
    height: 1.05rem !important;
    margin: 0 !important;
    font-size: 1.05rem !important;
  }
  img.preview,
  .preview {
    border-radius: 0 !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: contain !important;
    object-position: center;
    width: 100%;
    height: auto !important;
    background: #fff;
    border: 1px solid var(--rule);
    box-shadow: none !important;
  }
  .research-group {
    margin-top: 1.05rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .research-group:first-of-type {
    margin-top: 0.2rem;
    border-top: none;
    padding-top: 0;
  }
  .research-group h2 {
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--chrome);
    margin-bottom: 0.35rem;
  }
  .research-group p {
    margin-bottom: 0.55rem;
  }
  .research-lead {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .research-lead > div {
    flex: 1;
    min-width: 0;
  }
  .research-source {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .research-figure {
    flex: 0 0 9.25rem;
    width: 9.25rem;
    margin: 0;
  }
  .research-figure img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    height: auto;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .activity-section {
    clear: both;
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }
  .activity-section h2,
  .activity-list + .activity-more {
    font-weight: 400;
  }
  .activity-list {
    border-top: 1px solid var(--rule);
    margin-top: 0.35rem;
  }
  .activity-item {
    display: grid;
    grid-template-columns: 4.2rem 6.4rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .activity-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 2.35rem;
    margin: 0;
    padding: 0.2rem 0.35rem;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .activity-logo img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .activity-date {
    color: var(--muted);
    font: 700 0.78rem/1.35 Arial, Helvetica, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .activity-title {
    margin: 0 0 0.2rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .activity-meta,
  .activity-more {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .activity-more {
    margin-top: 0.8rem;
  }
  .publications {
    margin-top: 0.35rem;
  }
  .publications h2.bibliography {
    text-align: left;
    font-size: 1rem;
    color: var(--chrome);
    border-top: 1px solid var(--rule);
    margin: 0.8rem 0 0.35rem;
    padding-top: 0.35rem;
  }
  .publications h2.bibliography:first-of-type {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }
  .publications ol.bibliography {
    margin-bottom: 0;
  }
  .publications ol.bibliography > li {
    margin-bottom: 0.4rem;
  }
  .publications .row {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    margin: 0;
  }
  .publications .row > .abbr {
    flex: 0 0 6.25rem !important;
    max-width: 6.25rem !important;
    width: 6.25rem !important;
    padding: 0 !important;
  }
  .publications .row > .col-sm-8 {
    flex: 1 1 auto !important;
    max-width: none !important;
    width: auto !important;
    padding: 0 !important;
  }
  .publications .title,
  .publications .author,
  .publications .periodical {
    line-height: 1.35;
  }
  .publications .title a {
    color: inherit;
    text-decoration: none;
  }
  .publications .title a:hover,
  .publications .title a:focus {
    color: var(--accent);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  #navbar a:focus-visible,
  #navbar button:focus-visible {
    outline-color: #f7f4ee;
  }
  .publications img.preview,
  .publications .preview {
    display: block;
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    aspect-ratio: 1 / 1;
    object-fit: contain !important;
    object-position: center;
  }
  .site-footer {
    margin-top: 1.5rem;
    padding: 0.8rem 1rem;
    background: var(--chrome);
    color: #f7f4ee;
    text-align: center;
    font-size: 0.82rem;
  }
  .site-footer p {
    margin: 0;
    color: #f7f4ee;
  }
  .publications .abbr figure {
    margin: 0;
  }
  @media (max-width: 576px) {
    .profile,
    .profile img,
    .profile .img-fluid,
    .profile figure,
    .profile picture {
      float: none !important;
      width: 11rem !important;
    }
    .profile {
      margin: 0 0 0.7rem !important;
    }
    .navbar .navbar-nav {
      padding-bottom: 0.6rem;
    }
    img.preview,
    .preview {
      max-width: 220px;
    }
    .research-lead {
      flex-direction: column;
      align-items: flex-start;
    }
    .publications .row {
      gap: 0.45rem 0.85rem;
    }
    .publications .row > .col-sm-8 {
      display: contents;
    }
    .publications .title {
      grid-column: 2;
    }
    .publications .author,
    .publications .periodical {
      grid-column: 1 / -1;
    }
    .activity-item {
      grid-template-columns: 3.2rem 4.6rem minmax(0, 1fr);
      gap: 0.55rem;
    }
    .activity-logo {
      width: 4.6rem;
      height: 1.9rem;
      padding: 0.12rem 0.2rem;
    }
  }
  /* Site-wide reading scale and page rhythm. */
  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.0625rem;
    font-weight: 400;
  }
  body > .container[role="main"] {
    margin-top: 2.5rem !important;
    margin-bottom: 2.5rem;
  }
  .post h1.post-title {
    font-size: 2.25rem;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    letter-spacing: 0;
  }
  .post .post-header {
    margin-bottom: 2rem;
  }
  .post .desc,
  .post-description {
    color: var(--muted);
    font: 400 1rem/1.6 Arial, Helvetica, sans-serif;
  }
  .post article a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .post article a:hover {
    text-decoration-thickness: 2px;
  }
  .post article .social a,
  .post article .social a:hover,
  .post article .social a:focus {
    text-decoration: none;
    border-bottom: 0;
  }
  .navbar .navbar-nav .nav-link {
    font-size: 1rem;
    font-weight: 400;
    padding: 0.65rem 0.6rem;
  }
  .navbar .navbar-nav .active .nav-link {
    font-weight: 600;
  }
  /* The portrait keeps its natural 982:1600 aspect ratio. */
  .post:has(.profile) article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    grid-template-rows: auto 1fr;
    column-gap: 3rem;
    align-items: start;
  }
  .post:has(.profile) .profile {
    grid-column: 2;
    grid-row: 1 / span 2;
    float: none;
    width: 13rem !important;
    max-width: 13rem;
    margin: 0 !important;
  }
  .post:has(.profile) .profile img,
  .post:has(.profile) .profile .img-fluid,
  .post:has(.profile) .profile figure,
  .post:has(.profile) .profile picture {
    width: 100% !important;
    height: auto !important;
  }
  .post:has(.profile) .clearfix {
    grid-column: 1;
    grid-row: 1;
  }
  .post:has(.profile) .clearfix p {
    margin-bottom: 0.8rem;
  }
  .post:has(.profile) .social {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    clear: none;
    margin-top: 0.7rem;
  }
  .post:has(.profile) .social .contact-icons {
    gap: 1.2rem;
  }
  .post:has(.profile) .social .contact-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
  }
  .post:has(.profile) .social .contact-icons a i,
  .post:has(.profile) .social .contact-icons a svg {
    width: 1.2rem !important;
    height: 1.2rem !important;
    font-size: 1.2rem !important;
  }
  /* Three concise research sections, with one microscopy detail. */
  .post .research-group {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(15rem, 0.92fr);
    column-gap: 2.25rem;
    row-gap: 0.85rem;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.75rem;
  }
  .post .research-group h2 {
    grid-column: 1 / -1;
  }
  .post .research-copy {
    min-width: 0;
  }
  .post .research-copy p {
    max-width: none;
  }
  .post .research-group:first-of-type {
    margin-top: 0;
    padding-top: 0;
  }
  .post .research-group h2 {
    margin-bottom: 0;
    font-size: 1.6rem;
  }
  .post .research-group p {
    margin-bottom: 0.85rem;
  }
  .post .research-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 2rem;
    align-items: start;
  }
  .post .research-figure {
    width: 13rem;
    margin: 0;
  }
  .research-figure figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font: 400 0.8rem/1.5 Arial, Helvetica, sans-serif;
  }
  .post .research-note {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .post .research-lesson {
    width: 100%;
    min-width: 0;
    margin: 0;
  }
  .post .research-lesson img {
    position: static;
    display: block;
    width: 100%;
    max-width: 100% !important;
    height: auto !important;
    aspect-ratio: auto !important;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .publications .row > .abbr {
    min-width: 0;
  }
  /* Publication hierarchy and a larger image column. */
  .publications .row {
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
  }
  .publications .row > .abbr {
    width: 10rem !important;
    max-width: 10rem !important;
  }
  .publications ol.bibliography > li {
    margin-bottom: 1.25rem;
  }
  .publications h2.bibliography {
    margin: 1.7rem 0 1rem;
    padding-top: 1rem;
    font-size: 1.1rem;
  }
  .publications ol.bibliography li .title {
    margin-bottom: 0.5rem;
    color: var(--chrome);
    font: 400 1.2rem/1.35 Georgia, "Times New Roman", serif;
  }
  .publications .title a {
    color: var(--chrome);
  }
  .publications .title a:hover,
  .publications .title a:focus-visible {
    text-decoration: underline;
  }
  .publications .author {
    margin-bottom: 0.35rem;
    color: var(--muted);
  }
  .publications .author em {
    font-weight: 600;
  }
  .publications .author,
  .publications .periodical {
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .publication-actions {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }
  /* Event names lead; organization logos remain secondary. */
  .post .activity-item {
    grid-template-columns: 4rem minmax(0, 1fr) 7.5rem;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  .post .activity-item > :last-child {
    grid-column: 2;
    grid-row: 1;
  }
  .post .activity-logo {
    display: flex;
    grid-column: 3;
    grid-row: 1;
    min-width: 0;
    width: 7.5rem;
    height: 3.4rem;
    padding: 0.25rem 0.4rem;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .post .activity-logo img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .post .activity-title {
    margin-bottom: 0.3rem;
    font: 400 1.2rem/1.4 Georgia, "Times New Roman", serif;
  }
  .post .activity-title a {
    text-decoration: none;
  }
  .post .activity-title a:hover,
  .post .activity-title a:focus-visible {
    text-decoration: underline;
  }
  .post .activity-meta {
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .site-footer {
    padding: 1rem;
  }
  @media (max-width: 767px) {
    .post:has(.profile) article {
      grid-template-columns: minmax(0, 1fr) 11rem;
      column-gap: 1.5rem;
    }
    .post:has(.profile) .profile {
      width: 11rem !important;
      max-width: 11rem;
    }
    .post .research-group,
    .post .research-lead {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.85fr);
      gap: 1.25rem;
    }
    .post .research-figure {
      width: 11rem;
    }
  }
  @media (max-width: 575px) {
    body {
      font-size: 1rem;
    }
    body > .container[role="main"] {
      margin-top: 1.5rem !important;
      padding-inline: 20px;
    }
    .post h1.post-title {
      font-size: 2rem;
    }
    .post:has(.profile) article,
    .post .research-group,
    .post .research-lead {
      grid-template-columns: 1fr;
    }
    .post .research-lesson {
      width: min(100%, 28rem);
    }
    .post:has(.profile) .profile {
      grid-column: 1;
      grid-row: 1;
      width: 10rem !important;
      max-width: 10rem;
      margin-bottom: 1.25rem !important;
    }
    .post:has(.profile) .clearfix {
      grid-column: 1;
      grid-row: 2;
    }
    .post:has(.profile) .social {
      grid-column: 1;
      grid-row: 3;
      margin-top: 0.5rem;
    }
    .post .research-figure {
      width: 12.5rem;
    }
    .publications .row {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 0.5rem 1rem;
    }
    .publications .row > .abbr {
      width: 7rem !important;
      max-width: 7rem !important;
    }
    .publications ol.bibliography li .title {
      margin: 0;
      font-size: 1.06rem;
    }
    .publications .publication-actions {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .post .activity-item {
      grid-template-columns: 3rem minmax(0, 1fr) 4.8rem;
      gap: 0.6rem;
      align-items: center;
    }
    .post .activity-logo {
      display: flex;
      width: 4.8rem;
      height: 2.4rem;
    }
  }
</style>
<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ '/' | relative_url }}">
        {% if site.title == 'blank' %}
          {{- site.first_name }} {{ site.middle_name }} {{ site.last_name -}}
        {% else %}
          {{- site.title -}}
        {% endif %}
      </a>
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap ml-auto ms-auto">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.nav_label | default: p.title }}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}" {% if page.url contains parent_link %}aria-current="page"{% endif %}>
                    {{- p.nav_label | default: p.title }}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>
</header>
